{% extends "../layouts/base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>
    <p>{{ message }}</p>
    <p>
        Name: {{ galaxy.name }} <br> 
        Description: {{ galaxy.description }} <br>
        Size: {{ galaxy.size | number_format }} <br> 
    </p>
    <div>
    <a class="button" href="/galaxies/{{ galaxy.id }}/edit">Edit Galaxy</a>
  <a class="button" href="/galaxies/{{galaxy.id}}/delete">Delete Galaxy</a>
  </div>


{% endblock %}

{% block javascripts %}
    {# <script src="/public/app.js"></script> #}
{% endblock %}