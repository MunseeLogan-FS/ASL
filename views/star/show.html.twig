{% extends "../layouts/base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>
    <p>{{ message }}</p>
    <p>
        Name: {{ star.name }} <br> 
        Description: {{ star.description }} <br>
        Size: {{ star.size | number_format }} <br> 
        Galaxy: <a href="/galaxies/{{ galaxy.id }}">{{ galaxy.name }}</a> <br>
    </p>
    <div>
        <a class="button" href="/stars/{{ star.id }}/edit">Edit Star</a>
        <a class="button" href="/stars/{{ star.id }}/delete">Delete Star</a>
    </div>

{% endblock %}

{% block javascripts %}
    {# <script src="/public/app.js"></script> #}
{% endblock %}