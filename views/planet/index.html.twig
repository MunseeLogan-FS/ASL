{% extends "../layouts/base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>
    <p>{{ message }}</p>
    <ul>
        {% for planet in planets %}
            <li><a href="/planets/{{ planet.id }}">{{ planet.name }} - {{ planet.description }}</a></li>
        {% endfor %}
    </ul>
    <a href="/planets/new">Create Planet</a>
{% endblock %}

{% block javascripts %}
    {# <script src="/public/app.js"></script> #}
{% endblock %}