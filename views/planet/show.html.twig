{% extends "../layouts/base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>
    <p>{{ message }}</p>
    <p>
        Name: {{ planet.name }} <br> 
        Description: {{ planet.description }} <br>
        Size: {{ planet.size | number_format }} <br> 
        Stars: 
        {% if stars %}
           <a href="/stars/{{ stars.id }}">{{ stars.name }}</a>
        {% else %}
            No stars associated with this planet.
        {% endif %}
        
    </p>
        <a href="/planets/{{ planet.id }}/edit">Edit Planet</a>
        <a href="/planets/{{ planet.id }}/delete">Delete Planet</a>

{% endblock %}

{% block javascripts %}
    {# <script src="/public/app.js"></script> #}
{% endblock %}